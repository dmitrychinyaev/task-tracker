# Copy this file to .env and adjust values if needed.
# On Windows PowerShell: Copy-Item .env.example .env

POSTGRES_DB=tasktracker
POSTGRES_USER=tasktracker
POSTGRES_PASSWORD=tasktracker

# Backend uses this connection string. In Docker Compose the host is "db".
DATABASE_URL=postgresql+psycopg2://tasktracker:tasktracker@db:5432/tasktracker

# Directory where uploaded task images are stored (mounted as a Docker volume).
STORAGE_PATH=/data/uploads

# Maximum upload size in megabytes.
MAX_UPLOAD_SIZE_MB=10

# Telegram bot (long-polling intake service).
# Get the token from @BotFather.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# URL the bot uses to reach the FastAPI backend. In Docker Compose this is the service name.
TELEGRAM_BACKEND_URL=http://backend:8000
# Comma-separated Telegram user IDs allowed to create tasks (e.g. 123456,789012).
# Leave empty to allow everyone (not recommended).
TELEGRAM_ALLOWED_USER_IDS=
# Seconds to wait for the remaining photos of a Telegram album before saving it.
TELEGRAM_MEDIA_GROUP_WINDOW=2

